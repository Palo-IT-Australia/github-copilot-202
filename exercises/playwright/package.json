{
  "name": "qe-playwright-copilot-lab",
  "version": "1.0.0",
  "description": "Hands-on lab: diagnose and fix broken Playwright tests with GitHub Copilot in VS Code",
  "private": true,
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "start": "node app/server.js",
    "test": "playwright test",
    "tc1": "playwright test --grep @tc1",
    "tc2": "playwright test --grep @tc2",
    "api": "playwright test --grep @api",
    "smoke": "playwright test --grep @smoke",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
